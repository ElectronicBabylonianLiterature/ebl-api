# Auth0 Configuration
AUTH0_AUDIENCE=your-api-identifier
AUTH0_ISSUER=https://your-domain.auth0.com/
AUTH0_PEM=your-base64-encoded-certificate

# AI API Configuration
EBL_AI_API=http://localhost:8001

# MongoDB Configuration
MONGODB_DB=ebldev
MONGODB_URI=mongodb://localhost:27017/ebldev

# PyMongo In-Memory Configuration (for tests)
PYMONGOIM__MONGO_VERSION=4.4
PYMONGOIM__OPERATING_SYSTEM=ubuntu

# Sentry Configuration
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

GITGUARDIAN_API_KEY=gitguardian-api-key
MEDIA_API_ENABLED=false
MEDIA_UPLOAD_ENABLED=false
MEDIA_UPLOAD_MAX_BYTES=26214400
MEDIA_UPLOAD_MAX_PIXELS=40000000
MEDIA_UPLOAD_MAX_DIMENSION=20000
MEDIA_UPLOAD_DECODE_SLOTS=1
